{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heys.local/schemas/verdict-handoff-v1.json",
  "title": "HEYS verdict handoff",
  "description": "Canonical shape for zone verdict batch-apply handoffs. Legacy aliases (zone, key, contractLine, recommend, f, fDraft) are normalized by scripts/lib/handoff-schema.mjs before apply.",
  "type": "object",
  "required": ["zoneId"],
  "properties": {
    "zoneId": {
      "type": "string",
      "minLength": 1,
      "description": "Target docs/ui/verdicts/<zoneId>.json"
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "outOfScopeCssRows": {
      "type": "array",
      "items": { "$ref": "#/$defs/outOfScopeCssRow" }
    },
    "outOfScopeRuntimeRows": {
      "type": "array",
      "items": { "$ref": "#/$defs/outOfScopeRuntimeRow" }
    },
    "meta": {
      "type": "object",
      "properties": {
        "contractKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": { "type": "string" },
              "dataV": { "type": "string" },
              "h": { "type": "string" },
              "naKind": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "decisionRefDefault": { "type": "string" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["contractKey", "verdict", "fact"],
      "properties": {
        "contractKey": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["=", "≠", "?", "—", "!"]
        },
        "fact": { "type": "string", "minLength": 1 },
        "h": { "type": "string" },
        "note": { "type": "string" },
        "reasonCode": { "type": "string" },
        "decisionRef": { "type": "string" },
        "na-kind": { "type": "string" },
        "options": { "type": "object" }
      },
      "additionalProperties": true
    },
    "outOfScopeCssRow": {
      "type": "object",
      "required": ["contractKey"],
      "properties": {
        "contractKey": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["=", "≠", "?", "—", "!"]
        },
        "fact": { "type": "string" },
        "h": { "type": "string" },
        "decisionRef": { "type": "string" },
        "options": { "type": "object" }
      },
      "additionalProperties": true
    },
    "outOfScopeRuntimeRow": {
      "type": "object",
      "required": ["contractKey", "fact"],
      "properties": {
        "contractKey": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": ["=", "≠", "?", "—", "!"]
        },
        "fact": { "type": "string", "minLength": 1 },
        "h": { "type": "string" },
        "note": { "type": "string" },
        "decisionRef": { "type": "string" },
        "options": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
