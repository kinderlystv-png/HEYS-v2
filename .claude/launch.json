{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "full-stack (dev:local)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:local"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "web-only (avoid — no API)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3001
    },
    {
      "name": "api-only (avoid — use dev:local)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4001
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:landing"],
      "port": 3003
    },
    {
      "name": "landing-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/landing", "exec", "next", "dev"],
      "port": 3003,
      "autoPort": true
    }
  ]
}
