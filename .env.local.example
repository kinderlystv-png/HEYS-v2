# E2E smoke credentials — COPY to .env.local (gitignored). НЕ коммить .env.local.
#
# Агент: pnpm test:e2e:smoke (сам создаёт .env.local, setup БД, dev:local, тесты).
# Человеку на новой машине ничего настраивать не нужно, кроме кураторских кредов ниже
# (если нужен curator-login smoke; PIN smokes идут без них).
# См. TESTS/e2e/README.md и .cursor/rules/e2e-smoke.mdc

# === Dedicated E2E clients (scripts/db/migrations/2026-05-31 + login_v2 patch) ===
HEYS_TEST_E2E_CLIENT_ALEX_ID=11111111-1111-1111-1111-111111111111
HEYS_TEST_E2E_CLIENT_POPL_ID=22222222-2222-2222-2222-222222222222
HEYS_TEST_E2E_CLIENT_ALEX_NAME=E2E-TestAlex
HEYS_TEST_E2E_CLIENT_POPL_NAME=E2E-TestPopl

# PIN = access_code (non-weak, login scheme v2). После 2026-08-23 patch в БД.
HEYS_TEST_PHONE_E2E_ALEX=70000000001
HEYS_TEST_PIN_E2E_ALEX=1357
HEYS_TEST_ACCESS_CODE_E2E_ALEX=1357
HEYS_TEST_PHONE_E2E_POPL=70000000002
HEYS_TEST_PIN_E2E_POPL=9753
HEYS_TEST_ACCESS_CODE_E2E_POPL=9753

# === Куратор (единственное, что заполняешь руками на новой машине) ===
HEYS_TEST_CURATOR_EMAIL=
HEYS_TEST_CURATOR_PASSWORD=

# Optional overrides
# HEYS_E2E_BASE_URL=http://localhost:3001
# HEYS_E2E_API_URL=http://localhost:4001

# Legacy single-client PIN smoke (если нужен отдельный клиент)
# HEYS_TEST_PHONE=79991234567
# HEYS_TEST_PIN=1357
# HEYS_TEST_ACCESS_CODE=1357
