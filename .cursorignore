# Cursor: exclude from AI indexing / @-mentions (reduces noise + token use).
# Source edits stay in repo; agents can still open files manually if needed.

# --- Legacy public bundles (minified, hash-named; huge diffs, not for LLM context) ---
apps/web/public/**/*.bundle.*.js
apps/web/public/**/*.bundle.*.js.gz
apps/web/public/react-bundle.js
apps/web/public/react-bundle.js.gz

# --- Optional: large binary/reference dumps in repo root ---
src/**/*.pdf

# --- Legacy source concat bundles (generated; edit inputs in legacy-bundle-config.mjs) ---
apps/web/**/*_bundle_v1.js

# --- Reading book summaries (content data, rarely edited) ---
apps/web/reading/books/*.js

# --- Generated bundle manifests (CI/hooks rebuild; not agent edit targets) ---
apps/web/bundle-manifest.json
apps/web/public/bundle-manifest.json
apps/web/public/lazy-manifest.json
